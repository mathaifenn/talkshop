<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or 'Consulting and experiential leadership programmes by Dr. Mathai B. Fenn.' }}">
  <meta name="color-scheme" content="dark light">
  <title>{{ title or 'The Talk Shop' }} | Dr. Mathai B. Fenn</title>
  <link rel="stylesheet" href="/styles/site.css">
</head>
<body class="home-page">
  <input class="cover-toggle" type="checkbox" id="open-dossier">
  <section class="dossier-cover" aria-label="The Talk Shop introduction">
    <div class="cover-leaf cover-left">
      <div class="cover-copy">
        <p class="eyebrow">Corporate offerings</p>
        <h1>The<br>Talk<br>Shop</h1>
        <p class="cover-subtitle">Consulting &amp; Experiential Leadership Programmes</p>
      </div>
    </div>
    <div class="cover-leaf cover-right">
      <div class="portrait-placeholder" aria-hidden="true">MF</div>
      <h2>Dr. Mathai B. Fenn</h2>
      <p>Facilitator &amp; Author</p>
      <p class="credentials">PhD (IIT Bombay)<br>Former OB Head, XLRI Jamshedpur</p>
    </div>
    <div class="seal-area">
      <label class="wax-seal" for="open-dossier">
        <span>Open</span>
        <small>Click or tap to open</small>
      </label>
    </div>
  </section>

  <header class="site-header">
    <a class="wordmark" href="/">The Talk Shop</a>
    <nav aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="#programmes">Programmes</a>
      <a href="#about">About</a>
      <a href="mailto:mathai@thetalkshop.in">Contact</a>
    </nav>
  </header>

  <main class="page-shell">
    <div class="opened-heading">
      <div>
        <p class="eyebrow">Corporate offerings</p>
        <h1>The Talk Shop</h1>
        <p>Dr. Mathai B. Fenn</p>
      </div>
      <label class="close-link" for="open-dossier">Close dossier</label>
    </div>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <span>The Talk Shop</span>
    <span>Dr. Mathai B. Fenn · Kottayam, Kerala</span>
  </footer>
</body>
</html>
